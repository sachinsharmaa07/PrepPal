// apps/api/prisma/schema.prisma

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  STUDENT
  RECRUITER
  ADMIN
}

enum JobStatus {
  PENDING_MODERATION
  PUBLISHED
  REJECTED
  CLOSED
}

enum Tenure {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum ApplicationStatus {
  APPLIED
  UNDER_REVIEW
  SHORTLISTED
  REJECTED
  HIRED
}

enum ProblemDifficulty {
  EASY
  MEDIUM
  HARD
}

enum ProblemStatus {
  DRAFT
  PUBLISHED
}

enum Verdict {
  PENDING
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT_EXCEEDED
  RUNTIME_ERROR
  COMPILATION_ERROR
  MEMORY_LIMIT_EXCEEDED
}

enum Language {
  CPP
  JAVA
  PYTHON
  JAVASCRIPT
}

enum InterviewType {
  TECHNICAL
  DSA
  HR
  BEHAVIORAL
  ROLE_SPECIFIC
}

enum InterviewDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum InterviewStatus {
  IN_PROGRESS
  COMPLETED
}

enum NotificationType {
  APPLICATION_STATUS
  INTERVIEW_RESULT
  JOB_MODERATION
  SYSTEM
}

// ─────────────────────────────────────────────
// CORE / AUTH
// ─────────────────────────────────────────────

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  role          Role
  name          String
  avatarUrl     String?
  isVerified    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  profile              Profile?
  company              Company?
  resumes              Resume[]
  submissions          Submission[]
  userProblemCodes     UserProblemCode[]
  applications         Application[]
  interviewSessions    InterviewSession[]
  notifications        Notification[]

  @@index([email])
}

model Profile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio       String?
  education Json?    // [{ degree, institution, year, cgpa }]
  projects  Json?    // [{ title, description, techStack, link }]
  experience Json?   // [{ role, company, duration, description }]
  links     Json?    // { github, linkedin, portfolio }
  skillTags Skill[]  @relation("ProfileSkills")
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Skill {
  id       String    @id @default(uuid())
  name     String    @unique
  category String?
  profiles Profile[] @relation("ProfileSkills")
}

// ─────────────────────────────────────────────
// RECRUITER / JOBS
// ─────────────────────────────────────────────

model Company {
  id          String   @id @default(uuid())
  recruiterId String   @unique
  recruiter   User     @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  name        String
  logoUrl     String?
  website     String?
  industry    String?
  verified    Boolean  @default(false)
  jobs        Job[]

  @@index([recruiterId])
}

model Job {
  id              String        @id @default(uuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title           String
  description     String
  requirements    String[]
  skills          String[]
  location        String?
  isRemote        Boolean       @default(false)
  tenure          Tenure        @default(FULL_TIME)
  salaryMin       Int?
  salaryMax       Int?
  deadline        DateTime?
  status          JobStatus     @default(PUBLISHED)
  rejectionReason String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  applications    Application[]

  @@index([status, createdAt])
  @@index([skills])
  @@index([tenure])
}

model Application {
  id          String            @id @default(uuid())
  jobId       String
  job         Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeId    String?           // optional — student may not have uploaded a resume yet
  resume      Resume?           @relation(fields: [resumeId], references: [id])
  status      ApplicationStatus @default(APPLIED)
  matchScore  Float?
  appliedAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([jobId, userId])
  @@index([userId, appliedAt])
  @@index([jobId, status])
}

// ─────────────────────────────────────────────
// RESUME / ATS
// ─────────────────────────────────────────────

model Resume {
  id           String          @id @default(uuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileUrl      String          // S3 object key
  version      Int             @default(1)
  isActive     Boolean         @default(true)
  uploadedAt   DateTime        @default(now())
  analyses     ResumeAnalysis[]
  applications Application[]

  @@index([userId, isActive])
}

model ResumeAnalysis {
  id                 String   @id @default(uuid())
  resumeId           String
  resume             Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  jobId              String?  // nullable — generic analysis if no JD selected
  atsScore           Int
  keywordMatchScore  Int
  skillMatchScore    Int
  missingKeywords    String[]
  suggestions        Json     // [{ type, text }]
  parsedData         Json     // structured extraction result
  analyzedAt         DateTime @default(now())

  @@index([resumeId])
  @@index([resumeId, jobId])
}

// ─────────────────────────────────────────────
// CODING PLATFORM (ported from codesach)
// ─────────────────────────────────────────────

model CodingProblem {
  id            String            @id @default(uuid())
  title         String
  statementMd   String
  difficulty    ProblemDifficulty
  topics        String[]
  timeLimitMs   Int               @default(2000)
  memoryLimitMb Int               @default(256)
  status        ProblemStatus     @default(DRAFT)
  boilerplates  Json?             // { CPP: string, JAVA: string, PYTHON: string, JAVASCRIPT: string }
  metaData      Json?             // { name: string, params: [{name, type}], return: {type} }
  judgeConfig   Json?             // { timeLimitMs, memoryLimitMb, checkerType }
  createdBy     String            // admin userId
  createdAt     DateTime          @default(now())
  
  testCases         TestCase[]
  submissions       Submission[]
  userProblemCodes  UserProblemCode[]

  @@index([difficulty])
  @@index([topics])
}

model TestCase {
  id                 String        @id @default(uuid())
  problemId          String
  problem            CodingProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  inputRef           String        // inline text or S3 key for large inputs
  expectedOutputRef  String
  isSample           Boolean       @default(false)
  order              Int           @default(0)
  
  results            SubmissionTestResult[]

  @@index([problemId])
}

model UserProblemCode {
  id         String        @id @default(uuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId  String
  problem    CodingProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  language   Language
  code       String
  updatedAt  DateTime      @updatedAt

  @@unique([userId, problemId, language])
  @@index([userId, problemId])
}

model Submission {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId       String
  problem         CodingProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  language        Language
  code            String
  verdict         Verdict       @default(PENDING)
  
  totalTests      Int           @default(0)
  passedTests     Int           @default(0)
  failedTestCaseId String?
  
  runtimeMs       Int?
  memoryKb        Int?
  
  compileOutput   String?
  runtimeOutput   String?
  
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime      @default(now())

  testResults     SubmissionTestResult[]

  @@index([userId, problemId, createdAt])
  @@index([problemId, verdict])
}

model SubmissionTestResult {
  id              String        @id @default(uuid())
  submissionId    String
  submission      Submission    @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  testCaseId      String
  testCase        TestCase      @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  
  verdict         Verdict
  executionTimeMs Int?
  memoryUsedKb    Int?
  
  actualOutput    String?
  errorOutput     String?
  
  createdAt       DateTime      @default(now())

  @@index([submissionId])
  @@index([submissionId, testCaseId])
}

// ─────────────────────────────────────────────
// AI INTERVIEWS
// ─────────────────────────────────────────────

model InterviewSession {
  id           String              @id @default(uuid())
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         InterviewType
  difficulty   InterviewDifficulty
  role         String?
  status       InterviewStatus     @default(IN_PROGRESS)
  overallScore Float?
  createdAt    DateTime            @default(now())
  completedAt  DateTime?
  questions    InterviewQuestion[]

  @@index([userId, createdAt])
}

model InterviewQuestion {
  id           String            @id @default(uuid())
  interviewId  String
  interview    InterviewSession  @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  questionText String
  orderIndex   Int
  difficulty   InterviewDifficulty
  answer       InterviewAnswer?

  @@index([interviewId])
}

model InterviewAnswer {
  id          String            @id @default(uuid())
  questionId  String            @unique
  question    InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answerText  String
  score       Float?
  strengths   String[]
  weaknesses  String[]
  answeredAt  DateTime          @default(now())

  @@index([questionId])
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead, createdAt])
}
